@startuml
skinparam classAttributeIconSize 0
hide methods

class User {
  +id: UUID
  +fullName: string
  +email: string
  +passwordHash: string
  +isActive: boolean
  +createdAt: datetime
}
class Role {
  +id: UUID
  +name: RoleName
}
enum RoleName {
  ADMIN
  DEVOPS
  VIEWER
}
class Project {
  +id: UUID
  +name: string
  +description: string
  +createdAt: datetime
}
class Team {
  +id: UUID
  +name: string
}
class ProjectMember {
  +id: UUID
  +membershipRole: string
  +joinedAt: datetime
}
class Environment {
  +id: UUID
  +name: string
  +type: string
}
class Server {
  +id: UUID
  +name: string
  +hostname: string
  +operatingSystem: string
  +status: ServerStatus
}
enum ServerStatus {
  ONLINE
  DEGRADED
  OFFLINE
  UNKNOWN
}
class Application {
  +id: UUID
  +name: string
  +version: string
  +status: string
}
class Metric {
  +id: UUID
  +metricType: string
  +value: decimal
  +unit: string
  +recordedAt: datetime
}
class AlertRule {
  +id: UUID
  +name: string
  +metricType: string
  +operator: string
  +threshold: decimal
  +enabled: boolean
}
class Alert {
  +id: UUID
  +severity: string
  +status: string
  +observedValue: decimal
  +triggeredAt: datetime
  +resolvedAt: datetime
}
class Incident {
  +id: UUID
  +title: string
  +description: string
  +severity: string
  +status: string
  +createdAt: datetime
  +resolvedAt: datetime
}

Role "1" -- "0..*" User : assigned to
User "1" -- "0..*" ProjectMember
Project "1" -- "0..*" ProjectMember
Team "0..1" -- "0..*" ProjectMember
Project "1" -- "0..*" Environment
Environment "1" -- "0..*" Server
Environment "1" -- "0..*" Application
Server "0..1" -- "0..*" Application : hosted on
Server "1" -- "0..*" Metric
Server "0..1" -- "0..*" AlertRule : scoped to
AlertRule "1" -- "0..*" Alert
Server "0..1" -- "0..*" Alert
Alert "0..1" -- "0..*" Incident : may generate
User "0..1" -- "0..*" Incident : assigned to
@enduml
